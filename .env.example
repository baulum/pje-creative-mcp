# Copy this to .env (or .env.local, which takes precedence and is gitignored).
# Required: your KIE.ai API key (https://kie.ai/api-key)
KIE_API_KEY=your_kie_api_key_here

# Optional: override the KIE API base URL (default: https://api.kie.ai)
# KIE_BASE_URL=https://api.kie.ai

# Optional: override the KIE file-upload base URL (default: https://kieai.redpandaai.co)
# KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# Optional: default directory for download_result when no output_path is given
# PJE_OUTPUT_DIR=./output

# Optional: HTTP request timeout in milliseconds (default: 120000)
# KIE_REQUEST_TIMEOUT_MS=120000

# Optional: log level - silent | error | info | debug (default: info)
# PJE_LOG_LEVEL=info
